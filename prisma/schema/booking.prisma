model Booking {
  id                 String        @id @default(uuid())
  customerId         String
  technicianId       String
  serviceId          String
  scheduledStart     DateTime      @default(now())
  scheduledEnd       DateTime?     @updatedAt
  address            String
  status             BookingStatus @default(REQUESTED)
  totalAmount        Decimal       @db.Decimal(10, 2)
  currency           String        @default("BDT") @db.Char(5)
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  completedAt        DateTime?

  payment Payment?
  review  Review?

  technician TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  customer   User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service    Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, status])
  @@index([technicianId])
  @@index([technicianId, status])
  @@index([technicianId, scheduledStart])
  @@index([serviceId])
  @@map("bookings")
}
